ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://crm:crm@localhost:5432/crm
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=replace-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
INVITATION_EXPIRE_HOURS=72

FRONTEND_APP_URL=http://localhost:5173

EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# ---------------------------------------------------------------------------
# SMS · Masiv (avisos y campañas). LISTO: solo faltan las credenciales.
#   1. Pide a Masiv: usuario y contraseña de la API de SMS (masivapp) con envío a
#      EE. UU., y que confirme el registro 10DLC de la marca y la campaña (sin él,
#      los operadores de EE. UU. bloquean los mensajes masivos).
#   2. Pon SMS_PROVIDER=masiv, MASIV_USERNAME y MASIV_PASSWORD.
#   3. MASIV_SMS_URL solo cambia si Masiv te asigna otra URL.
#   4. Respuestas (STOP/START): genera un token largo (p. ej. `openssl rand -hex 24`),
#      ponlo en MASIV_WEBHOOK_TOKEN y pídele a Masiv que reenvíe las respuestas a
#      https://<dominio-de-la-app>/api/v1/webhooks/masiv/inbound?token=<ese token>
# Mientras SMS_PROVIDER=console, nada sale: queda como "No enviado (modo de prueba)".
# ---------------------------------------------------------------------------
SMS_PROVIDER=console
MASIV_SMS_URL=https://api-sms.masivapp.com/send-message
MASIV_USERNAME=
MASIV_PASSWORD=
MASIV_SENDER=PAPCRM
MASIV_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------
# Correo de CAMPAÑAS (mercadeo). LISTO: solo falta el buzón.
# Usa un buzón NUEVO y propio, distinto del Gmail de avisos (EMAIL_*): un envío
# masivo desde Gmail bloquea la cuenta.
#   Buzón a crear: promociones@<dominio de Delta HVAC>  (p. ej. promociones@deltahvac.com)
#   Dónde: Amazon SES (va con el plan de AWS). En SES:
#     a) verifica el dominio (registros DKIM, SPF y DMARC en el DNS del dominio),
#     b) pide salir del "sandbox" de SES para poder enviar a cualquier correo,
#     c) crea credenciales SMTP (IAM) → van en MARKETING_SMTP_USERNAME/PASSWORD.
#   Si no es SES, sirve cualquier proveedor SMTP: cambia MARKETING_SMTP_HOST/PORT.
# MARKETING_POSTAL_ADDRESS es obligatoria por ley (CAN-SPAM): dirección física real.
# Mientras MARKETING_EMAIL_PROVIDER=console, nada sale (modo de prueba).
# ---------------------------------------------------------------------------
MARKETING_EMAIL_PROVIDER=console
# Ej.: MARKETING_EMAIL_FROM="Delta HVAC <promociones@deltahvac.com>" (con el dominio real ya verificado en SES)
MARKETING_EMAIL_FROM=
MARKETING_EMAIL_REPLY_TO=
MARKETING_SMTP_HOST=email-smtp.us-west-2.amazonaws.com
MARKETING_SMTP_PORT=587
MARKETING_SMTP_USERNAME=
MARKETING_SMTP_PASSWORD=
MARKETING_SMTP_USE_TLS=true
MARKETING_POSTAL_ADDRESS=
# URL pública de la API para el enlace de baja (vacío = FRONTEND_APP_URL).
PUBLIC_API_URL=

S3_BUCKET=
AWS_REGION=us-east-1

# ---------------------------------------------------------------------------
# Permiso municipal (spec 2026-10-16-instalar-con-permiso-radicado)
# ---------------------------------------------------------------------------
# false (por defecto): para pasar a «Listo para instalar» el permiso tiene que
#   estar aprobado por la ciudad y vigente (o «No requerido»).
# true: basta con haberlo radicado; la aprobación se registra cuando llegue.
# En los dos casos un permiso rechazado o vencido bloquea, y el cobro al
# programa sigue pidiendo el permiso aprobado. Cambiarlo exige reiniciar la API.
PERMIT_FILED_ALLOWS_INSTALL=false

# --- Pagos en línea y banca conectada (spec docs/superpowers/specs/2026-10-25-pagos-tarjeta-design.md) ---
# Vacíos = apagado (no aparece «Cobrar» en línea ni «Conectar cuenta»).
# Stripe: llaves de la cuenta de Delta HVAC (modo prueba: sk_test_...). El webhook va a
#   https://<dominio>/api/v1/webhooks/stripe con los eventos checkout.session.completed,
#   checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
#   charge.refunded y charge.dispute.created.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Plaid: client_id y secret del panel de Plaid; PLAID_ENV=sandbox para probar sin bancos reales.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Llave Fernet para cifrar los tokens de Plaid (obligatoria fuera de desarrollo):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYMENTS_ENCRYPTION_KEY=
# URL pública de la API (para el webhook de Plaid).
# PUBLIC_API_URL=https://<dominio>
